# ---------------------------------------------------------------------------
# BreakGlass environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# Origins — must match how you actually open the app
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
# Optional extra origins, comma separated (e.g. a preview domain)
ALLOWED_ORIGINS=

# Database (MongoDB is the system of record)
MONGODB_URI=mongodb://127.0.0.1:27017/breakglass

# Session / encryption secrets  (REQUIRED IN PRODUCTION)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=k1
SESSION_COOKIE_NAME=bg_session
SESSION_TTL_DAYS=14

# Queue
# QUEUE_DRIVER=redis  uses Redis + BullMQ (durable jobs, retries, stalled-job recovery)
# QUEUE_DRIVER=mongo  uses the bundled MongoDB-backed queue (no extra service)
# QUEUE_DRIVER=auto   picks redis when REDIS_URL is set, otherwise mongo
QUEUE_DRIVER=auto
REDIS_URL=

# Email alerts (choose one; leave EMAIL_PROVIDER=none for the dev outbox)
EMAIL_PROVIDER=none            # none | resend | smtp
EMAIL_FROM="BreakGlass Alerts <alerts@your-domain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Evidence storage (private local volume; mount a persistent disk in production)
ARTIFACT_DIR=.data/artifacts

# GitHub deployment webhooks (optional per-project secret is set in the UI)
GITHUB_WEBHOOK_SECRET=

# Workers / scheduler
WORKER_CONCURRENCY=4
BROWSER_CONCURRENCY=2
SCHEDULER_INTERVAL_MS=15000

# Security switches
# Development only: allow monitoring of private/loopback targets. Ignored in production.
ALLOW_PRIVATE_TARGETS=false
MONITOR_USER_AGENT=BreakGlass-Monitor/1.0 (+https://breakglass.app/bot)

# Retention
RETENTION_DAYS_RUNS=30
RETENTION_DAYS_ARTIFACTS=14

# Local demo data (optional): creates a demo workspace on `npm run seed`
DEV_SEED=false
